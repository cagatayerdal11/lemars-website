# =====================================================================
# LEMARS — Dijital Performans Sistemi ortam değişkenleri (ÖRNEK)
# Bu dosya güvenlidir (gerçek değer içermez). Gerçek değerleri
# .env.local dosyasına veya Vercel > Project > Settings > Environment
# Variables ekranına girin. SECRET değerleri ASLA commit etmeyin.
# =====================================================================

# ---- Google Analytics 4 (public — tarayıcıda görünür) ----
# GA4 web data stream "Measurement ID" (G- ile başlar).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site kök adresi (email linki, robots host). Public.
NEXT_PUBLIC_SITE_URL=https://www.lemarsgida.com

# ---- Google Analytics Data API (server-only, SECRET) ----
# GA4 property numarası (Admin > Property Settings > Property ID). Sadece rakam.
GA4_PROPERTY_ID=123456789

# ---- Google servis hesabı (GA4 + Search Console için ortak, SECRET) ----
# Servis hesabının e-postası.
GOOGLE_CLIENT_EMAIL=lemars-reporting@your-project.iam.gserviceaccount.com
# Servis hesabı private key. Satır sonları \n olarak TEK satırda yazılmalı,
# çift tırnak içinde. Örn: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Google Search Console (server-only) ----
# Property URL'i. URL-prefix property ise sonda / ile: https://www.lemarsgida.com/
# Domain property ise: sc-domain:lemarsgida.com
SEARCH_CONSOLE_SITE_URL=https://www.lemarsgida.com/

# ---- E-posta (Resend — mevcut) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Doğrulanmış gönderen. Örn: "LEMARS Raporlama <rapor@lemarsgida.com>"
REPORT_EMAIL_FROM=LEMARS Raporlama <rapor@lemarsgida.com>
# Alıcı(lar). Virgülle birden fazla adres desteklenir.
# Kodda varsayılan: cagatayerdal@icloud.com — bu değişkenle ezebilirsiniz.
REPORT_EMAIL_TO=cagatayerdal@icloud.com
# (Opsiyonel) Email içindeki "Detaylı Raporu Görüntüle" linki için özel adres.
# Boş bırakılırsa NEXT_PUBLIC_SITE_URL/admin/rapor kullanılır.
# ADMIN_DASHBOARD_URL=https://www.lemarsgida.com/admin/rapor

# ---- Admin paneli (server-only, SECRET) ----
# Parolanın güvenli (tuzlu scrypt) hash'i. Üretmek için:
#   node scripts/generate-admin-hash.mjs 'GUCLU_PAROLANIZ'
# Çıktı "scrypt$...$..." biçimindedir; olduğu gibi yapıştırın.
ADMIN_PASSWORD_HASH=scrypt$REPLACE$WITH_GENERATED_VALUE
# Oturum imzalama anahtarı — uzun rastgele değer. Üretmek için:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTES_HEX

# ---- Cron güvenliği (server-only, SECRET) ----
# Aylık email endpoint'ini korur. Üretmek için: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_RANDOM_HEX

# ---- (Opsiyonel, mevcut) WhatsApp Business bildirimleri ----
# İletişim formu bildirimini WhatsApp'a da göndermek için (zorunlu değil).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
